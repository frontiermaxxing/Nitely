{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nitely",
  "version": "0.1.0",
  "identifier": "net.quixet.nitely",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nitely",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright 2026 Quixet LLC",
    "license": "Apache-2.0",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nitely"
        ]
      }
    }
  }
}
