{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }],
    "PreToolUse":       [{ "matcher": "mcp__.*|Bash|PowerShell", "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] },
                         { "matcher": "mcp__nitely__(submit|submit_status|land|quick_land|run|run_status)$", "hooks": [{ "type": "command", "command": "nitely wake claude", "timeout": 3600, "async": true, "asyncRewake": true }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "nitely hook claude", "timeout": 5 }] }]
  }
}
